#!/usr/bin/env bash
set -euo pipefail

chapter="${1:-${ROS_ACTIVE_CHAPTER:-Chapter03}}"
chapter_dir="${PACKT_REPO}/${chapter}"
chapter_ws="${CHAPTER_WS}/${chapter}"

if [[ ! -d "${chapter_dir}" ]]; then
  echo "Capitolo non trovato: ${chapter_dir}" >&2
  echo "Valori attesi: Chapter03 ... Chapter16 (Chapter02 non contiene pacchetti colcon)." >&2
  exit 2
fi

set +u
source "/opt/ros/${ROS_DISTRO}/setup.bash"
set -u

mkdir -p \
  "${chapter_ws}/build" \
  "${chapter_ws}/install" \
  "${chapter_ws}/log"

colcon \
  --log-base "${chapter_ws}/log" \
  build \
  --base-paths "${chapter_dir}" \
  --build-base "${chapter_ws}/build" \
  --install-base "${chapter_ws}/install" \
  --symlink-install

echo
echo "Overlay compilato: ${chapter_ws}/install"
echo "Per attivarlo nella shell corrente:"
echo "  source ${chapter_ws}/install/setup.bash"
