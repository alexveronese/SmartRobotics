#!/usr/bin/env bash
set -euo pipefail

headless="${DEMO_HEADLESS:-false}"
auto_start="${DEMO_AUTO_START:-true}"

while (($#)); do
  case "$1" in
    --headless)
      headless=true
      ;;
    --manual)
      auto_start=false
      ;;
    *)
      printf 'Argomento non riconosciuto: %s\n' "$1" >&2
      printf 'Uso: run-square-sorting-demo [--headless] [--manual]\n' >&2
      exit 2
      ;;
  esac
  shift
done

if [[ "${headless}" == "true" ]]; then
  exec ros2 launch square_sorting_demo square_sorting.launch.py \
    headless:=true auto_start:="${auto_start}"
fi

export DISPLAY="${DISPLAY:-:1}"
export LIBGL_ALWAYS_SOFTWARE="${LIBGL_ALWAYS_SOFTWARE:-1}"
export QT_X11_NO_MITSHM=1
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp/runtime-ros}"
mkdir -p "${XDG_RUNTIME_DIR}"
chmod 0700 "${XDG_RUNTIME_DIR}"

Xvfb "${DISPLAY}" -screen 0 1440x900x24 -ac +extension GLX +render -noreset &
fluxbox -display "${DISPLAY}" &
x11vnc \
  -display "${DISPLAY}" \
  -forever \
  -shared \
  -nopw \
  -listen 127.0.0.1 \
  -rfbport 5900 &
websockify \
  --web=/usr/share/novnc/ \
  0.0.0.0:6080 \
  127.0.0.1:5900 &

printf 'Gazebo GUI via noVNC: http://localhost:6080/vnc.html?autoconnect=1&resize=scale\n'
exec ros2 launch square_sorting_demo square_sorting.launch.py \
  headless:=false auto_start:="${auto_start}"
