#!/usr/bin/env bash
set -euo pipefail

chapter="${1:-${ROS_ACTIVE_CHAPTER:-Chapter03}}"
chapter_dir="${PACKT_REPO}/${chapter}"

if [[ ! -d "${chapter_dir}" ]]; then
  echo "Capitolo non trovato: ${chapter_dir}" >&2
  echo "Valori attesi: Chapter03 ... Chapter16 (Chapter02 non contiene pacchetti colcon)." >&2
  exit 2
fi

set +u
source "/opt/ros/${ROS_DISTRO}/setup.bash"
set -u

sudo apt-get update
rosdep update --rosdistro "${ROS_DISTRO}"
rosdep install \
  --from-paths "${chapter_dir}" \
  --ignore-src \
  --rosdistro "${ROS_DISTRO}" \
  -r \
  -y
sudo rm -rf /var/lib/apt/lists/*
