<?xml version="1.0"?>
<sdf version="1.10">
  <world name="square_sorting">
    <physics name="fast_and_stable" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.08 0.10 0.13 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 3 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -1.0</direction>
    </light>
    <light name="work_light" type="point">
      <pose>0.55 0 1.5 0 0 0</pose>
      <cast_shadows>false</cast_shadows>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>4</range>
        <constant>0.6</constant>
        <linear>0.1</linear>
        <quadratic>0.01</quadratic>
      </attenuation>
    </light>

    <model name="ground">
      <static>true</static>
      <pose>0 0 -0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>3.0 2.4 0.04</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>3.0 2.4 0.04</size></box>
          </geometry>
          <material>
            <ambient>0.14 0.16 0.18 1</ambient>
            <diffuse>0.18 0.20 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="robot_pedestal">
      <static>true</static>
      <pose>0 0 -0.225 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.11</radius><length>0.45</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.11</radius><length>0.45</length></cylinder>
          </geometry>
          <material>
            <ambient>0.12 0.15 0.19 1</ambient>
            <diffuse>0.16 0.20 0.26 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="source_table">
      <static>true</static>
      <pose>0.53 0.33 -0.025 0 0 0</pose>
      <link name="table">
        <collision name="top_collision">
          <geometry><box><size>0.56 0.46 0.05</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <geometry><box><size>0.56 0.46 0.05</size></box></geometry>
          <material>
            <ambient>0.34 0.38 0.42 1</ambient>
            <diffuse>0.42 0.47 0.52 1</diffuse>
          </material>
        </visual>
        <collision name="leg_1_collision">
          <pose>0.22 0.17 -0.225 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.40</size></box></geometry>
        </collision>
        <collision name="leg_2_collision">
          <pose>0.22 -0.17 -0.225 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.40</size></box></geometry>
        </collision>
        <collision name="leg_3_collision">
          <pose>-0.22 0.17 -0.225 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.40</size></box></geometry>
        </collision>
        <collision name="leg_4_collision">
          <pose>-0.22 -0.17 -0.225 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.40</size></box></geometry>
        </collision>
        <visual name="legs_visual">
          <pose>0 0 -0.225 0 0 0</pose>
          <geometry><box><size>0.49 0.39 0.40</size></box></geometry>
          <material>
            <ambient>0.12 0.14 0.17 1</ambient>
            <diffuse>0.15 0.18 0.22 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="destination_table">
      <static>true</static>
      <pose>0.53 -0.33 -0.025 0 0 0</pose>
      <link name="table">
        <collision name="top_collision">
          <geometry><box><size>0.56 0.46 0.05</size></box></geometry>
        </collision>
        <visual name="top_visual">
          <geometry><box><size>0.56 0.46 0.05</size></box></geometry>
          <material>
            <ambient>0.27 0.34 0.31 1</ambient>
            <diffuse>0.34 0.43 0.39 1</diffuse>
          </material>
        </visual>
        <collision name="leg_1_collision">
          <pose>0.22 0.17 -0.225 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.40</size></box></geometry>
        </collision>
        <collision name="leg_2_collision">
          <pose>0.22 -0.17 -0.225 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.40</size></box></geometry>
        </collision>
        <collision name="leg_3_collision">
          <pose>-0.22 0.17 -0.225 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.40</size></box></geometry>
        </collision>
        <collision name="leg_4_collision">
          <pose>-0.22 -0.17 -0.225 0 0 0</pose>
          <geometry><box><size>0.045 0.045 0.40</size></box></geometry>
        </collision>
        <visual name="legs_visual">
          <pose>0 0 -0.225 0 0 0</pose>
          <geometry><box><size>0.49 0.39 0.40</size></box></geometry>
          <material>
            <ambient>0.12 0.15 0.14 1</ambient>
            <diffuse>0.16 0.20 0.18 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="square_1">
      <pose>0.44 0.24 0.021 0 0 0.18</pose>
      <link name="body">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.000035</ixx><iyy>0.000035</iyy><izz>0.00006</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.068 0.068 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.068 0.068 0.04</size></box></geometry>
          <material>
            <ambient>1.0 0.22 0.02 1</ambient>
            <diffuse>1.0 0.28 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="square_2">
      <pose>0.61 0.35 0.021 0 0 -0.30</pose>
      <link name="body">
        <inertial>
          <mass>0.08</mass>
          <inertia>
            <ixx>0.000035</ixx><iyy>0.000035</iyy><izz>0.00006</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.068 0.068 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.068 0.068 0.04</size></box></geometry>
          <material>
            <ambient>1.0 0.22 0.02 1</ambient>
            <diffuse>1.0 0.28 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="triangle_1">
      <pose>0.46 0.43 0.001 0 0 -0.15</pose>
      <link name="body">
        <inertial>
          <mass>0.06</mass>
          <inertia>
            <ixx>0.00003</ixx><iyy>0.00003</iyy><izz>0.00004</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <polyline>
              <height>0.04</height>
              <point>-0.038 -0.032</point>
              <point>0.038 -0.032</point>
              <point>0 0.040</point>
            </polyline>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <polyline>
              <height>0.04</height>
              <point>-0.038 -0.032</point>
              <point>0.038 -0.032</point>
              <point>0 0.040</point>
            </polyline>
          </geometry>
          <material>
            <ambient>1.0 0.22 0.02 1</ambient>
            <diffuse>1.0 0.28 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="triangle_2">
      <pose>0.63 0.17 0.001 0 0 0.28</pose>
      <link name="body">
        <inertial>
          <mass>0.06</mass>
          <inertia>
            <ixx>0.00003</ixx><iyy>0.00003</iyy><izz>0.00004</izz>
          </inertia>
        </inertial>
        <collision name="collision">
          <geometry>
            <polyline>
              <height>0.04</height>
              <point>-0.038 -0.032</point>
              <point>0.038 -0.032</point>
              <point>0 0.040</point>
            </polyline>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <polyline>
              <height>0.04</height>
              <point>-0.038 -0.032</point>
              <point>0.038 -0.032</point>
              <point>0 0.040</point>
            </polyline>
          </geometry>
          <material>
            <ambient>1.0 0.22 0.02 1</ambient>
            <diffuse>1.0 0.28 0.03 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="overhead_camera">
      <static>true</static>
      <pose>0.52 0 1.35 0 1.57079632679 0</pose>
      <link name="camera_link">
        <sensor name="sorting_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>12</update_rate>
          <visualize>true</visualize>
          <topic>/sorting_camera/image</topic>
          <camera>
            <horizontal_fov>1.0471975512</horizontal_fov>
            <image>
              <width>800</width>
              <height>700</height>
              <format>RGB_INT8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>5.0</far>
            </clip>
            <camera_info_topic>/sorting_camera/camera_info</camera_info_topic>
          </camera>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
