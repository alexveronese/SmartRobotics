<?xml version="1.0" ?>
<sdf version="1.9">
  <world name="tic_tac_toe">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>500</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static><pose>0 0 -0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2 2 0.04</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2 2 0.04</size></box></geometry>
          <material><ambient>0.16 0.30 0.18 1</ambient><diffuse>0.22 0.42 0.25 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="robot_pedestal">
      <static>true</static><pose>0 0 -0.215 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.16</radius><length>0.43</length></cylinder></geometry></collision>
        <visual name="visual"><geometry><cylinder><radius>0.16</radius><length>0.43</length></cylinder></geometry>
          <material><ambient>0.12 0.15 0.19 1</ambient><diffuse>0.16 0.20 0.26 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="table">
      <!-- Top X range is [0.245, 0.895], leaving 85 mm from the 0.16 m pedestal. -->
      <static>true</static><pose>0.57 0 -0.025 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.65 0.68 0.05</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.65 0.68 0.05</size></box></geometry>
          <material><ambient>0.42 0.22 0.08 1</ambient><diffuse>0.52 0.30 0.12 1</diffuse></material>
        </visual>
        <collision name="leg_1"><pose>0.27 0.28 -0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry></collision>
        <collision name="leg_2"><pose>0.27 -0.28 -0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry></collision>
        <collision name="leg_3"><pose>-0.27 0.28 -0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry></collision>
        <collision name="leg_4"><pose>-0.27 -0.28 -0.225 0 0 0</pose><geometry><box><size>0.04 0.04 0.40</size></box></geometry></collision>
        <visual name="legs"><pose>0 0 -0.225 0 0 0</pose><geometry><box><size>0.58 0.59 0.40</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.22 0.22 0.22 1</diffuse></material></visual>
      </link>
    </model>

    <model name="board">
      <static>true</static><pose>0.57 0 0 0 0 0</pose>
      <link name="link">
        <collision name="board_collision"><pose>0 0 0.008 0 0 0</pose><geometry><box><size>0.32 0.32 0.016</size></box></geometry></collision>
        <visual name="board_visual"><pose>0 0 0.008 0 0 0</pose><geometry><box><size>0.32 0.32 0.016</size></box></geometry>
          <material><ambient>0.86 0.85 0.74 1</ambient><diffuse>0.92 0.91 0.80 1</diffuse></material>
        </visual>
        <visual name="vline_1"><pose>0 -0.05 0.019 0 0 0</pose><geometry><box><size>0.30 0.008 0.006</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="vline_2"><pose>0 0.05 0.019 0 0 0</pose><geometry><box><size>0.30 0.008 0.006</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="hline_1"><pose>-0.05 0 0.019 0 0 0</pose><geometry><box><size>0.008 0.30 0.006</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
        <visual name="hline_2"><pose>0.05 0 0.019 0 0 0</pose><geometry><box><size>0.008 0.30 0.006</size></box></geometry><material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Fixed top-down camera. Its optical +X axis is rotated toward world -Z. -->
    <model name="overhead_camera">
      <static>true</static><pose>0.57 0 1.25 0 1.570796 0</pose>
      <link name="camera_link">
        <visual name="housing"><geometry><box><size>0.06 0.06 0.08</size></box></geometry><material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material></visual>
        <sensor name="board_camera" type="camera">
          <always_on>true</always_on><update_rate>15</update_rate><topic>/camera/image_raw</topic>
          <camera>
            <horizontal_fov>0.92</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.05</near><far>3.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- Red X supply. Each link has two crossed box visuals and one small collision. -->
    <model name="x_piece_1"><pose>0.31 0.26 0.007 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.014</length></cylinder></geometry></collision><visual name="a"><pose>0 0 0 0 0 0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><visual name="b"><pose>0 0 0 0 0 -0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><inertial><mass>0.03</mass></inertial></link></model>
    <model name="x_piece_2"><pose>0.41 0.26 0.007 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.014</length></cylinder></geometry></collision><visual name="a"><pose>0 0 0 0 0 0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><visual name="b"><pose>0 0 0 0 0 -0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><inertial><mass>0.03</mass></inertial></link></model>
    <model name="x_piece_3"><pose>0.51 0.26 0.007 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.014</length></cylinder></geometry></collision><visual name="a"><pose>0 0 0 0 0 0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><visual name="b"><pose>0 0 0 0 0 -0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><inertial><mass>0.03</mass></inertial></link></model>
    <model name="x_piece_4"><pose>0.61 0.26 0.007 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.014</length></cylinder></geometry></collision><visual name="a"><pose>0 0 0 0 0 0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><visual name="b"><pose>0 0 0 0 0 -0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><inertial><mass>0.03</mass></inertial></link></model>
    <model name="x_piece_5"><pose>0.71 0.26 0.007 0 0 0</pose><link name="link"><collision name="c"><geometry><cylinder><radius>0.033</radius><length>0.014</length></cylinder></geometry></collision><visual name="a"><pose>0 0 0 0 0 0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><visual name="b"><pose>0 0 0 0 0 -0.7854</pose><geometry><box><size>0.065 0.014 0.014</size></box></geometry><material><ambient>0.9 0.03 0.03 1</ambient><diffuse>0.9 0.03 0.03 1</diffuse></material></visual><inertial><mass>0.03</mass></inertial></link></model>

    <!-- Blue O supply. Dynamic cylinders attach to the Panda with a native fixed joint. -->
    <model name="o_piece_1"><pose>0.31 -0.26 0.015 0 0 0</pose><link name="o_piece_link_1"><collision name="o_piece_collision_1"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><material><ambient>0.02 0.15 0.95 1</ambient><diffuse>0.02 0.15 0.95 1</diffuse></material></visual><inertial><mass>0.05</mass><inertia><ixx>0.0000182</ixx><iyy>0.0000182</iyy><izz>0.0000289</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link></model>
    <model name="o_piece_2"><pose>0.41 -0.26 0.015 0 0 0</pose><link name="o_piece_link_2"><collision name="o_piece_collision_2"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><material><ambient>0.02 0.15 0.95 1</ambient><diffuse>0.02 0.15 0.95 1</diffuse></material></visual><inertial><mass>0.05</mass><inertia><ixx>0.0000182</ixx><iyy>0.0000182</iyy><izz>0.0000289</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link></model>
    <model name="o_piece_3"><pose>0.51 -0.26 0.015 0 0 0</pose><link name="o_piece_link_3"><collision name="o_piece_collision_3"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><material><ambient>0.02 0.15 0.95 1</ambient><diffuse>0.02 0.15 0.95 1</diffuse></material></visual><inertial><mass>0.05</mass><inertia><ixx>0.0000182</ixx><iyy>0.0000182</iyy><izz>0.0000289</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link></model>
    <model name="o_piece_4"><pose>0.61 -0.26 0.015 0 0 0</pose><link name="o_piece_link_4"><collision name="o_piece_collision_4"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><material><ambient>0.02 0.15 0.95 1</ambient><diffuse>0.02 0.15 0.95 1</diffuse></material></visual><inertial><mass>0.05</mass><inertia><ixx>0.0000182</ixx><iyy>0.0000182</iyy><izz>0.0000289</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link></model>
    <model name="o_piece_5"><pose>0.71 -0.26 0.015 0 0 0</pose><link name="o_piece_link_5"><collision name="o_piece_collision_5"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision><visual name="visual"><geometry><cylinder><radius>0.034</radius><length>0.030</length></cylinder></geometry><material><ambient>0.02 0.15 0.95 1</ambient><diffuse>0.02 0.15 0.95 1</diffuse></material></visual><inertial><mass>0.05</mass><inertia><ixx>0.0000182</ixx><iyy>0.0000182</iyy><izz>0.0000289</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial></link></model>
  </world>
</sdf>
