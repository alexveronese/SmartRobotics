<?xml version="1.0"?>
<robot name="sorting_robot">

  <material name="grigio"><color rgba="0.5 0.5 0.5 1.0"/></material>
  <material name="blu"><color rgba="0.0 0.0 0.8 1.0"/></material>
  <material name="rosso"><color rgba="0.8 0.0 0.0 1.0"/></material>
  <material name="nero"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <link name="world"/>
  <joint name="virtual_joint" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ROBOT BASE -->
  <link name="base_link">
    <visual><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="grigio"/></visual>
    <collision><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/><child link="link_1"/>
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
    <axis xyz="0 0 1"/> 
    <limit lower="-3.14" upper="3.14" effort="100.0" velocity="1.5"/>
  </joint>

  <link name="link_1">
    <visual><origin xyz="0 0 0.1"/><geometry><cylinder radius="0.06" length="0.2"/></geometry><material name="blu"/></visual>
    <collision><origin xyz="0 0 0.1"/><geometry><cylinder radius="0.06" length="0.2"/></geometry></collision>
    <inertial><origin xyz="0 0 0.1"/><mass value="1.5"/><inertia ixx="0.005" ixy="0" ixz="0" iyy="0.005" iyz="0" izz="0.005"/></inertial>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="link_1"/><child link="arm_link"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> 
    <limit lower="-1.57" upper="1.57" effort="100.0" velocity="1.5"/>
  </joint>

  <link name="arm_link">
    <visual><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.04" length="0.3"/></geometry><material name="grigio"/></visual>
    <collision><origin xyz="0 0 0.15"/><geometry><cylinder radius="0.04" length="0.3"/></geometry></collision>
    <inertial><origin xyz="0 0 0.15"/><mass value="1.0"/><inertia ixx="0.003" ixy="0" ixz="0" iyy="0.003" iyz="0" izz="0.003"/></inertial>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="arm_link"/><child link="forearm_link"/>
    <origin xyz="0 0 0.3" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> <limit lower="-2.0" upper="2.0" effort="50.0" velocity="1.5"/>
  </joint>

  <link name="forearm_link">
    <visual><origin xyz="0 0 0.125"/><geometry><cylinder radius="0.03" length="0.25"/></geometry><material name="blu"/></visual>
    <collision><origin xyz="0 0 0.125"/><geometry><cylinder radius="0.03" length="0.25"/></geometry></collision>
    <inertial><origin xyz="0 0 0.125"/><mass value="0.8"/><inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002"/></inertial>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="forearm_link"/><child link="gripper_base"/>
    <origin xyz="0 0 0.25" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> 
    <limit lower="-1.57" upper="1.57" effort="30.0" velocity="2.0"/>
  </joint>

  <link name="gripper_base">
    <visual><origin xyz="0 0 0.02"/><geometry><box size="0.04 0.12 0.04"/></geometry><material name="nero"/></visual>
    <collision><origin xyz="0 0 0.02"/><geometry><box size="0.04 0.12 0.04"/></geometry></collision>
    <inertial><origin xyz="0 0 0.02"/><mass value="0.3"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>

  <joint name="joint_left_finger" type="prismatic">
    <parent link="gripper_base"/><child link="left_finger"/>
    <origin xyz="0 0.04 0.04" rpy="0 0 0"/>
    <axis xyz="0 -1 0"/> 
    <limit lower="0" upper="0.03" effort="20.0" velocity="0.5"/>
  </joint>

  <link name="left_finger">
    <visual><origin xyz="0 0 0.03"/><geometry><box size="0.02 0.01 0.06"/></geometry><material name="rosso"/></visual>
    <collision><origin xyz="0 0 0.03"/><geometry><box size="0.02 0.01 0.06"/></geometry></collision>
    <inertial><origin xyz="0 0 0.03"/><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <joint name="joint_right_finger" type="prismatic">
    <parent link="gripper_base"/><child link="right_finger"/>
    <origin xyz="0 -0.04 0.04" rpy="0 0 0"/>
    <axis xyz="0 1 0"/> 
    <limit lower="0" upper="0.03" effort="20.0" velocity="0.5"/>
  </joint>

  <link name="right_finger">
    <visual><origin xyz="0 0 0.03"/><geometry><box size="0.02 0.01 0.06"/></geometry><material name="rosso"/></visual>
    <collision><origin xyz="0 0 0.03"/><geometry><box size="0.02 0.01 0.06"/></geometry></collision>
    <inertial><origin xyz="0 0 0.03"/><mass value="0.05"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>

  <!-- CONTROLLORI GAZEBO -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_1"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="joint_2"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="joint_3"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="joint_4"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="joint_left_finger"><command_interface name="position"/><state_interface name="position"/></joint>
    <joint name="joint_right_finger"><command_interface name="position"/><state_interface name="position"/></joint>
  </ros2_control>

  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>/home/parallels/jazzy_ws/src/nuovo_progetto/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- TELECAMERA -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="nero"/>
    </visual>
    <!-- AGGIUNGIAMO QUESTO PER RENDERE IL LINK "VISIBILE" A GAZEBO -->
    <collision>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="camera_joint" type="fixed">
    <parent link="world"/>
    <child link="camera_link"/>
    <origin xyz="0.4 0 0.9" rpy="0 1.57 0"/>
  </joint>

  <gazebo reference="camera_link">
    <sensor type="camera" name="telecamera_tavolo">
      <update_rate>30.0</update_rate>
      <topic>camera/image_raw</topic> <!-- Questo deve corrispondere -->
      <camera name="obiettivo">
        <horizontal_fov>1.2</horizontal_fov>
        <image><width>640</width><height>480</height><format>R8G8B8</format></image>
        <clip><near>0.1</near><far>10.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

</robot>